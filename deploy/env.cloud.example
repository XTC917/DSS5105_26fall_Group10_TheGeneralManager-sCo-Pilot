# Cloud environment template for the FastAPI backend.
# Copy these values into Render's Environment/Secret settings.
# Never commit a filled-in copy of this file.

# ---- LLM ----------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- Database -----------------------------------------------------------
# Recommended: two Neon connection options if the free plan allows extra roles.
# DATABASE_URL is used by the normal runtime (factory_agent-equivalent).
# PG_ADMIN_* is used by migrations, admin pages and the LangGraph checkpointer.
#
# If the provider only gives you one owner role, use the same direct connection
# for both and record that as a least-privilege follow-up.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
PG_ADMIN_DATABASE_URL=
PG_ADMIN_USER=
PG_ADMIN_PASSWORD=
PGHOST=
PGPORT=5432
PGDATABASE=
PGSCHEMA=app
PG_ADMIN_META_SCHEMA=admin_meta
PG_COPILOT_SCHEMA=copilot
PG_AUTH_SCHEMA=auth
PGCONNECT_TIMEOUT=10
PG_STATEMENT_TIMEOUT_MS=30000
PG_READ_STATEMENT_TIMEOUT_MS=5000

# ---- Authentication -----------------------------------------------------
# Generate a random value of at least 32 characters.
AUTH_SECRET_KEY=
# Generate a separate random code used only when creating an ADMIN account.
ADMIN_REGISTRATION_CODE=

# ---- Browser access -----------------------------------------------------
# Comma-separated HTTPS origins. Do not use "*" with credentials.
# Example: https://your-app.vercel.app,https://your-app-git-test.vercel.app
CORS_ORIGINS=
