# Copy this file to .env and fill in a key before using the chat agent.
# Tools and the database work without an LLM key; /api/chat does not.

# --- LLM provider switch -----------------------------------------------
# Development (Gemini, default when GOOGLE_API_KEY is set):
#   LLM_PROVIDER=gemini
#   LLM_MODEL=gemini-3.6-flash     (current default; if AI Studio renames it,
#                                 use the exact name shown there)
#   GOOGLE_API_KEY=AIza...       (from https://aistudio.google.com/app/apikey)
#
# Switch back to GPT later (one block, uncomment + set LLM_PROVIDER):
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=             (leave empty for api.openai.com)
# ------------------------------------------------------------------------

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GOOGLE_API_KEY=

# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- PostgreSQL (integrated backend) ------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=factory_copilot_db
PGSCHEMA=app
PG_ADMIN_META_SCHEMA=admin_meta
PG_COPILOT_SCHEMA=copilot
PG_AUTH_SCHEMA=auth
PGUSER=factory_agent
PGPASSWORD=
PG_ADMIN_USER=factory_admin
PG_ADMIN_PASSWORD=
PGCONNECT_TIMEOUT=5
PG_STATEMENT_TIMEOUT_MS=30000
PG_READ_STATEMENT_TIMEOUT_MS=5000

# Authentication
ADMIN_REGISTRATION_CODE=
