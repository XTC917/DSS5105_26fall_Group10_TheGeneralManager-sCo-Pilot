# Copy this file to .env. Fill in the key yourself. Do not commit .env.

# Chat uses OpenAI gpt-5.6. The app already calls the Responses API for this model.
# Leave OPENAI_BASE_URL empty to use api.openai.com.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Gemini is not the current setup. Uncomment this block only if you switch providers,
# and comment out the OpenAI block above.
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.6-flash
# GOOGLE_API_KEY=

# --- PostgreSQL ---------------------------------------------------------
# Host, database, and schemas match the local project database.
# factory_agent is the account the running app uses.
# factory_admin is the account for setup and migrations.
# Passwords below are the ones set for those roles on this project.
# If you chose different passwords in postgresql_database/sql/01_roles_and_database.sql,
# put those here instead.
PGHOST=localhost
PGPORT=5432
PGDATABASE=factory_copilot_db
PGSCHEMA=app
PG_ADMIN_META_SCHEMA=admin_meta
PG_COPILOT_SCHEMA=copilot
PG_AUTH_SCHEMA=auth
PGUSER=factory_agent
PGPASSWORD=agent
PG_ADMIN_USER=factory_admin
PG_ADMIN_PASSWORD=admin
PGCONNECT_TIMEOUT=5
PG_STATEMENT_TIMEOUT_MS=30000
PG_READ_STATEMENT_TIMEOUT_MS=5000

# Alembic on this version reads PGUSER and PGPASSWORD, not PG_ADMIN_USER.
# factory_agent cannot create tables. Before `alembic upgrade`, point those two
# at factory_admin / admin, then put factory_agent / agent back for the app.

# Authentication. Generate your own values. Do not copy someone else's.
# AUTH_SECRET_KEY must be at least 32 characters or login will fail.
ADMIN_REGISTRATION_CODE=
AUTH_SECRET_KEY=
